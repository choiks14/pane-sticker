<Window x:Class="PaneSticker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaneSticker 설정" Width="470" Height="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Background="#FF1B1D24" Foreground="#FFE8EAF0">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8EAF0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8EAF0" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7FA9FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF262A34" />
            <Setter Property="Foreground" Value="#FFE8EAF0" />
            <Setter Property="BorderBrush" Value="#FF3A4050" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,12,16,12">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ResetButton" Content="기본값 복원" Padding="12,5" Margin="0,0,8,0" Click="OnReset" />
                <Button Content="닫기" Padding="18,5" Click="OnClose" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FF232732" CornerRadius="4" Padding="10,7" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="터미널 탐색 중..." FontWeight="SemiBold" />
                <TextBlock x:Name="DiagText" Text="" Foreground="#FFFFB86C" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Section}" Text="표시" />

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="투명도" Width="90" />
                    <TextBlock DockPanel.Dock="Right" x:Name="OpacityValue" Width="46" TextAlignment="Right" />
                    <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="1.0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </DockPanel>

                <CheckBox x:Name="ShowBadgesCheck" Content="패인 번호 배지 표시" />
                <CheckBox x:Name="ShowBordersCheck" Content="패인 구역 테두리 표시" />
                <CheckBox x:Name="ShowTitleCheck" Content="배지에 터미널 제목도 표시" />

                <DockPanel Margin="0,6,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="배지 내용" Width="90" />
                    <ComboBox x:Name="LabelModeCombo" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="배지 위치" Width="90" />
                    <ComboBox x:Name="AnchorCombo" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="배지 글자크기" Width="90" />
                    <TextBlock DockPanel.Dock="Right" x:Name="FontValue" Width="46" TextAlignment="Right" />
                    <Slider x:Name="FontSlider" Minimum="8" Maximum="32" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="배지 여백" Width="90" />
                    <TextBlock DockPanel.Dock="Right" x:Name="MarginValue" Width="46" TextAlignment="Right" />
                    <Slider x:Name="MarginSlider" Minimum="0" Maximum="40" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="테두리 두께" Width="90" />
                    <TextBlock DockPanel.Dock="Right" x:Name="BorderValue" Width="46" TextAlignment="Right" />
                    <Slider x:Name="BorderSlider" Minimum="0.5" Maximum="6" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Style="{StaticResource Section}" Text="색상 (#AARRGGBB)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="일반 패인" />
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="AccentBox" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="활성 패인" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="FocusBox" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="글자" />
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TextColorBox" Margin="0,2" />
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="패인 이름 (비우면 번호만 표시)" />
                <ItemsControl x:Name="LabelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding Header}" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Section}" Text="동작" />
                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="표시 조건" Width="90" />
                    <ComboBox x:Name="VisibilityCombo" DisplayMemberPath="Text" SelectedValuePath="Value" />
                </DockPanel>

                <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Text="갱신 주기" Width="90" />
                    <TextBlock DockPanel.Dock="Right" x:Name="PollValue" Width="60" TextAlignment="Right" />
                    <Slider x:Name="PollSlider" Minimum="80" Maximum="1500" TickFrequency="10"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF9AA3B5"
                           Text="단축키 — Ctrl+Alt+P: 오버레이 켜기/끄기, Ctrl+Alt+-: 투명도 낮춤, Ctrl+Alt+=: 투명도 높임" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
